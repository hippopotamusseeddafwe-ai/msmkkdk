rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated user cloud save progress & backup
    match /user_progress/{userId} {
      allow read, write: if true;
    }

    // Public real-time leaderboard
    match /leaderboard/{playerId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Live global roll feed
    match /recent_global_rolls/{rollId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Multiplayer Aura Duels
    match /aura_duels/{duelId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Multiplayer Aura & Item Trades
    match /trades/{tradeId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
